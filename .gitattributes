# Auto detect text files and normalize line endings to LF
* text=auto

# Python
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Markdown & Documentation
*.md text eol=lf
*.markdown text eol=lf
README text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Binary files
*.shp binary
*.shx binary
*.dbf binary
*.gdb binary
*.gpkg binary
*.tif binary
*.tiff binary
*.img binary
*.las binary
*.laz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
